# built application files
*.apk
*.ap_

# files for the dex VM
*.dex

# Java class files
*.class

# generated files
bin/
gen/

# Local configuration file (sdk path, etc)
local.properties

# Eclipse project files
.classpath
.project
/target/

# Generated HTML from README
readme.html

# JWT signing keys — generated locally on first run by KeyGenerator
# (infrastructure.security). Must never be committed: a private key checked
# into git history lets anyone with repo access mint valid admin JWTs.
src/main/resources/META-INF/resources/privateKey.pem
src/main/resources/META-INF/resources/publicKey.pem
